{
  "name": "AudioSmith",
  "identifier": "dev.hehehai.audiosmith",
  "version": "0.1.0",
  "out": "build",
  "urlSchemes": [
    "audiosmith"
  ],
  "macos": {
    "minimumSystemVersion": "15.0",
    "infoPlist": {
      "LSApplicationCategoryType": "public.app-category.music",
      "NSMicrophoneUsageDescription": "AudioSmith records your voice for voice cloning, transcription and dictation. Audio stays on this Mac."
    }
  },
  "fileAssociations": [
    {
      "ext": [
        "asvoice"
      ],
      "name": "AudioSmith Voice",
      "mimeType": "application/vnd.audiosmith.voice+zip",
      "role": "Editor"
    },
    {
      "ext": [
        "ovsvoice"
      ],
      "name": "VoiceStudio Voice",
      "role": "Viewer"
    }
  ]
}
