From: AudioSmith
Subject: [PATCH] ui: ForgetGlyphs empties the shared glyph atlases

The glyph and mask atlases belong to the process-wide text system that
every window and Tester shares. Where a glyph lands in them depends on
everything drawn before, and glyphs drawn scaled (a zoomed-out canvas)
are sampled between pixels, so another place rounds a pixel or two by
one level: a test's pictures changed with the tests that ran before it.

ui.ForgetGlyphs (text.System.ForgetGlyphs, scene.Atlas.ResetSize) forgets
the glyphs and masks and empties both atlases to their first size, so a
test that calls it first draws as in a fresh process. Test in the patch
(TestForgetGlyphs, fails without the reset).
---
diff --git a/internal/scene/atlas.go b/internal/scene/atlas.go
index aac24fb..2ece3d8 100644
--- a/internal/scene/atlas.go
+++ b/internal/scene/atlas.go
@@ -234,6 +234,12 @@ func (a *Atlas) Reset() {
 	a.changedAll()
 }
 
+// ResetSize empties the atlas and makes it w×h, as NewAtlas would.
+func (a *Atlas) ResetSize(w, h int) {
+	a.W, a.H, a.Pix = w, h, make([]byte, w*h*a.BPP)
+	a.Reset()
+}
+
 // changedAll makes renderers upload the whole atlas.
 func (a *Atlas) changedAll() {
 	a.gen++
diff --git a/internal/text/raster.go b/internal/text/raster.go
index 1f24b0a..1166f66 100644
--- a/internal/text/raster.go
+++ b/internal/text/raster.go
@@ -226,6 +226,27 @@ func (s *System) makeRoom(color bool, want int, size image.Point, grow bool) {
 	}
 }
 
+// ForgetGlyphs forgets every glyph and mask drawn and empties the atlases
+// to the size a new System starts with: where the next glyphs go no
+// longer depends on what was drawn before, which can round glyphs drawn
+// scaled (sampled between pixels) by a level. For tests that compare
+// pictures; nothing may be painting.
+func (s *System) ForgetGlyphs() {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	clear(s.glyphs)
+	clear(s.places)
+	clear(s.runs)
+	clear(s.masks)
+	clear(s.transient)
+	clear(s.recent)
+	s.MaskAtlas.ResetSize(256, 256) // as newSystem
+	s.ColorAtlas.ResetSize(1, 1)
+	s.full, s.want = [2]bool{}, [2]int{}
+	s.wantSize = [2]image.Point{}
+	s.rooms = 0
+}
+
 // Glyph rasterizes glyph id of a font at scale pixels per DIP whose pen
 // is x device pixels from the left, for text of a shade, placed as the
 // system's text stack places glyphs: at one of the positions within a
diff --git a/internal/text/text_test.go b/internal/text/text_test.go
index 54384fb..475372f 100644
--- a/internal/text/text_test.go
+++ b/internal/text/text_test.go
@@ -378,6 +378,48 @@ func TestMakeRoom(t *testing.T) {
 	s.EndFrame()
 }
 
+// TestForgetGlyphs: after ForgetGlyphs, masks go where they go in a new
+// System, whatever was drawn before (more than fills the first atlas).
+func TestForgetGlyphs(t *testing.T) {
+	var calls int
+	draw := func(s *System, from, n int) []GlyphImage {
+		var gs []GlyphImage
+		for range 2 { // the second frame makes them last
+			gs = gs[:0]
+			s.BeginFrame()
+			for i := range n {
+				key := uint64(from + i)
+				g := s.Mask(key, square(10+i%7*9, byte(i+1), &calls))
+				for try := 0; !g.OK && try < 2; try++ {
+					s.MakeRoom()
+					g = s.Mask(key, square(10+i%7*9, byte(i+1), &calls))
+				}
+				gs = append(gs, g)
+			}
+			s.EndFrame()
+		}
+		return gs
+	}
+	fresh := newSystem()
+	want := draw(fresh, 1, 40)
+	s := newSystem()
+	draw(s, 1000, 400)
+	if s.MaskAtlas.W == fresh.MaskAtlas.W {
+		t.Fatal("the earlier masks did not grow the atlas")
+	}
+	s.ForgetGlyphs()
+	got := draw(s, 1, 40)
+	if !slices.Equal(got, want) || s.MaskAtlas.W != fresh.MaskAtlas.W || s.MaskAtlas.H != fresh.MaskAtlas.H {
+		t.Errorf("after ForgetGlyphs: %v in %d×%d, a new System: %v in %d×%d",
+			got, s.MaskAtlas.W, s.MaskAtlas.H, want, fresh.MaskAtlas.W, fresh.MaskAtlas.H)
+	}
+	for i, g := range got {
+		if s.maskPixel(g) != byte(i+1) {
+			t.Fatalf("mask %d: %+v holds %d", i, g, s.maskPixel(g))
+		}
+	}
+}
+
 // Thin masks can need a much wider or taller atlas without taking much
 // area: one MakeRoom must accommodate them, whatever the starting size.
 func TestMakeRoomForLongMasks(t *testing.T) {
diff --git a/ui/headless.go b/ui/headless.go
index eb22e7c..d436d7f 100644
--- a/ui/headless.go
+++ b/ui/headless.go
@@ -242,6 +242,12 @@ func coreNewTester(view func(c *context), width, height int) *Tester {
 	return t
 }
 
+// ForgetGlyphs empties the glyph atlases every window shares, so that
+// what a Tester draws next does not depend on what earlier tests drew:
+// where a glyph sits in its atlas can round text drawn scaled (a zoomed
+// canvas) by a level. Call it between Testers, not while one draws.
+func ForgetGlyphs() { textSystem().ForgetGlyphs() }
+
