+// TestRunPublish uploads a build made before, checked against the version.
+func TestRunPublish(t *testing.T) {
+	t.Setenv("AWS_ACCESS_KEY_ID", "id")
+	t.Setenv("AWS_SECRET_ACCESS_KEY", "secret")
+	var (
+		mu  sync.Mutex
+		put []string
+	)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		io.Copy(io.Discard, r.Body)
+		mu.Lock()
+		put = append(put, r.URL.EscapedPath())
+		mu.Unlock()
+	}))
+	defer srv.Close()
+	pub, _, _ := ed25519.GenerateKey(nil)
+	root := t.TempDir()
+	config := func(version string) {
+		data, _ := json.Marshal(map[string]any{
+			"name": "App", "version": version, "out": "build",
+			"updates": map[string]any{"publicKey": base64.StdEncoding.EncodeToString(pub), "url": "https://dl.example.com/app",
+				"s3": map[string]any{"bucket": "downloads", "prefix": "app", "endpoint": srv.URL}},
+		})
+		os.WriteFile(filepath.Join(root, "mygo.json"), data, 0o644)
+	}
+	config("1.3.0-beta.1")
+	dir := filepath.Join(root, "build", "darwin-arm64")
+	os.MkdirAll(filepath.Join(dir, "App.app", "Contents"), 0o755)
+	for name, content := range map[string]string{
+		"App-1.3.0-beta.1.dmg":                         "disk image, renamed",
+		"app-1.3.0-beta.1-darwin-arm64.tar.gz":         "archive",
+		"app-1.2.0-to-1.3.0-beta.1-darwin-arm64.delta": "delta",
+		"update-darwin-arm64.json":                     `{"version": "1.3.0-beta.1"}`,
+		".DS_Store":                                    "",
+	} {
+		os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644)
+	}
+	if err := runPublish([]string{"-platform", "darwin/arm64", root}); err != nil {
+		t.Fatal(err)
+	}
+	slices.Sort(put[:3])
+	if want := []string{
+		"/downloads/app/beta/App-1.3.0-beta.1.dmg",
+		"/downloads/app/beta/app-1.2.0-to-1.3.0-beta.1-darwin-arm64.delta",
+		"/downloads/app/beta/app-1.3.0-beta.1-darwin-arm64.tar.gz",
+		"/downloads/app/beta/update-darwin-arm64.json",
+	}; !slices.Equal(put, want) {
+		t.Errorf("uploaded\n%v\nwant\n%v", put, want)
+	}
+
+	// A build of another version, or of none, is not published.
+	put = nil
+	config("1.3.0-beta.2")
+	if err := runPublish([]string{"-platform", "darwin/arm64", root}); err == nil || !strings.Contains(err.Error(), "is of version 1.3.0-beta.1, not 1.3.0-beta.2") || put != nil {
+		t.Errorf("another version: %v, uploaded %v", err, put)
+	}
+	if err := runPublish([]string{"-platform", "linux/amd64", root}); err == nil || !strings.Contains(err.Error(), "no build of linux/amd64") {
+		t.Errorf("no build: %v", err)
+	}
+	if err := runPublish([]string{"-platform", "web", root}); err == nil {
+		t.Error("published the web platform")
+	}
+}
