+// foldRunGaps adds the room Core Text leaves between two runs of a line to
+// the advance of the right-most glyph of the run on the left. Core Text
+// spaces some characters apart by their context, as a bracket next to a
+// letter of another script: within a run it widens a glyph's advance,
+// but between runs, as of two fonts, it only moves the glyphs of the run
+// after. Lines are as wide as their advances, which are then as wide as
+// Core Text's own lines, which it breaks paragraphs by: a text laid out at
+// its own width keeps to one line.
+func (e *coreText) foldRunGaps(runs []shapedRun) {
+	if len(runs) < 2 {
+		return
+	}
+	// Where each run starts on the screen, how wide its glyphs are and
+	// which of them is right-most, leaving out marks, which take no room.
+	e.extents = slices.Grow(e.extents[:0], len(runs))[:len(runs)]
+	ext := e.extents
+	for k, r := range runs {
+		x := runExtent{last: -1}
+		for i, g := range r.glyphs {
+			if g.Advance == 0 {
+				continue
+			}
+			if x.last < 0 || g.X < x.left {
+				x.left = g.X
+			}
+			if x.last < 0 || g.X >= r.glyphs[x.last].X {
+				x.last = i
+			}
+			x.width += g.Advance
+		}
+		ext[k] = x
+	}
+	for a, x := range ext {
+		if x.last < 0 {
+			continue
+		}
+		// The run that follows it on the screen.
+		next, found := float32(0), false
+		for b, y := range ext {
+			if b != a && y.last >= 0 && y.left > x.left && (!found || y.left < next) {
+				next, found = y.left, true
+			}
+		}
+		if gap := next - (x.left + x.width); found && (gap > 1e-4 || gap < -1e-4) {
+			g := &runs[a].glyphs[x.last]
+			g.Advance = max(g.Advance+gap, 0)
+		}
+	}
+}
+
+// runExtent is where a run of a line starts, how wide it is, and its
+// right-most glyph, or -1 when it has none that takes room.
+type runExtent struct {
+	left, width float32
+	last        int
+}
