From: AudioSmith
Subject: [PATCH] ui/editor: soft wraps measure rows as they paint

Soft wraps summed the widths of characters shaped one by one, and the
rows were then shaped whole to paint. On macOS, Core Text shapes a
Chinese or Japanese comma or full stop alone half as wide as between
ideographs (7.6 DIPs against 15.1 in the system font at 15 points), so a
wrapped row of Chinese prose came out wider than the wrap width by half
a letter per punctuation mark, 30-40 DIPs a row, and its last letters
were cut at the editor's edge. Kerned Latin pairs and Pango's rounding
of positions change a row's width too, by less.

wrapBreaks now sums the advances the characters take in the line,
shaped in pieces as long rows are (lineAdvances), and shapes each row it
breaks as it paints, giving back a place to break at a time until the
row fits (fitRow). Lines in a monospaced font, all ASCII, are summed as
before. Test in the patch (TestWrappedRowsFitTheWrapWidth: on macOS 26
360 rows past the width without the change, none with it).
---
diff --git a/ui/editor/view.go b/ui/editor/view.go
index 1ca4583..66dd72a 100644
--- a/ui/editor/view.go
+++ b/ui/editor/view.go
@@ -53,6 +53,7 @@ type view struct {
 	// highlighter has not confirmed yet.
 	approx     bool
 	tokScratch []Token
+	advScratch []float32 // lineAdvances'
 }
 
 // inlay is text shown in a line at an offset, as an inlay hint or a
@@ -641,7 +642,9 @@ func (v *view) piece(l *lineLayout, p *rowPiece) *text.Layout {
 // wrapBreaks returns where the displayed text s breaks into rows when
 // wrapping, as Zed's LineWrapper: summing the advances of characters,
 // breaking after whitespace or between a word and what is not, anywhere
-// in CJK, and inside a word too long for a row.
+// in CJK, and inside a word too long for a row. The advances are those
+// the characters take in the line (lineAdvances); a row is then shaped
+// as it paints and given back characters until it fits (fitRow).
 func (v *view) wrapBreaks(s string) []int {
 	if !v.wrap || v.wrapWidth <= 0 {
 		return nil
@@ -650,6 +653,8 @@ func (v *view) wrapBreaks(s string) []int {
 	if v.widths.mono > 0 && float32(len(s))*v.widths.mono <= width {
 		return nil
 	}
+	adv := v.lineAdvances(s)
+	exact := v.widths.mono > 0 && isASCII(s)
 	var breaks []int
 	indent := float32(0)
 	x := float32(0)
@@ -660,18 +665,28 @@ func (v *view) wrapBreaks(s string) []int {
 		if i > start && canBreak(prev, r) {
 			last = i
 		}
-		w := v.widths.of(r)
+		w := adv[i]
 		if x+w > width && i > start {
 			at := i
 			if last > start {
 				at = last
 			}
+			rowIndent := indent
+			if len(breaks) == 0 {
+				rowIndent = 0
+			}
+			if !exact {
+				at = v.fitRow(s, start, at, rowIndent)
+			}
 			breaks = append(breaks, at)
 			if indent == 0 {
 				indent = v.wrapIndent(s)
 			}
 			// Measure the new row from its start, after the indent.
-			x = indent + v.widths.width(s[at:i])
+			x = indent
+			for j := at; j < i; j++ {
+				x += adv[j]
+			}
 			start, last = at, -1
 		}
 		x += w
@@ -680,6 +695,85 @@ func (v *view) wrapBreaks(s string) []int {
 	return breaks
 }
 
+// fitRow returns where the row of s from start, indented by indent, ends
+// at the latest, at or before at, for its text, shaped as it paints, to
+// fit the wrap width: the sum of the advances in the line misses what
+// changes at the row's edges (Pango rounds a letter's position in its
+// line, not its advance). It gives back a place to break at a time,
+// a character at a time in a word, and keeps a character at least.
+// Spaces ending the row hang past the width, as they did.
+func (v *view) fitRow(s string, start, at int, indent float32) int {
+	for range 64 {
+		row := strings.TrimRight(s[start:at], " ")
+		if row == "" {
+			return at
+		}
+		l := text.Shared().Shape(text.Params{Text: row, Style: v.style, NoWrap: true, KeepSpaces: true})
+		if indent+l.Width <= v.wrapWidth {
+			return at
+		}
+		// The place to break before at, or else the character before it.
+		back := -1
+		var prev rune
+		for j, r := range s[start:at] {
+			if j > 0 && canBreak(prev, r) {
+				back = start + j
+			}
+			prev = r
+		}
+		if back <= start {
+			_, size := utf8.DecodeLastRuneInString(s[start:at])
+			back = at - size
+		}
+		if back <= start {
+			return at
+		}
+		at = back
+	}
+	return at
+}
+
+// lineAdvances returns the advance of each character of the displayed
+// text s, by the byte it starts at (0 for the other bytes), as the line
+// shapes: letters take another width in a line than alone, as kerned
+// pairs, and in Chinese and Japanese text on macOS a comma or a full stop
+// that Core Text shapes alone is half as wide as between ideographs (7.6
+// DIPs and 15.1 at 15 points). Summing the widths of letters alone, wrapped
+// rows came out wider than the wrap width and their last letters were cut
+// at the edge. Text in a monospaced font, all ASCII, is summed as before.
+// The slice is the view's, valid until the next call.
+func (v *view) lineAdvances(s string) []float32 {
+	adv := slices.Grow(v.advScratch[:0], len(s))[:len(s)]
+	clear(adv)
+	v.advScratch = adv
+	if v.widths.mono > 0 && isASCII(s) {
+		for i := range len(s) {
+			adv[i] = v.widths.of(rune(s[i]))
+		}
+		return adv
+	}
+	// Shaped in pieces, as long rows are (shapeRow), so that a very long
+	// line is not shaped at once.
+	for a := 0; a < len(s); {
+		b := min(a+pieceBytes, len(s))
+		for b < len(s) && !utf8.RuneStart(s[b]) {
+			b++
+		}
+		piece := s[a:b]
+		l := text.Shared().Shape(text.Params{Text: piece, Style: v.style, NoWrap: true, KeepSpaces: true})
+		bytesOf := runeBytes(piece)
+		for _, ln := range l.Lines {
+			for _, g := range ln.Glyphs {
+				if g.Cluster >= 0 && g.Cluster < len(bytesOf) {
+					adv[a+bytesOf[g.Cluster]] += g.Advance
+				}
+			}
+		}
+		a = b
+	}
+	return adv
+}
+
 // wrapIndent is how far rows after the first are indented: as far as the
 // line, but no more than half the wrap width.
 func (v *view) wrapIndent(s string) float32 {
diff --git a/ui/editor/wrap_fit_test.go b/ui/editor/wrap_fit_test.go
new file mode 100644
index 0000000..0aa98e3
--- /dev/null
+++ b/ui/editor/wrap_fit_test.go
@@ -0,0 +1,64 @@
+package editor
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/egoist/mygo/internal/text"
+	"github.com/egoist/mygo/ui"
+)
+
+// wrapFitTexts are lines whose letters take another width in a line than
+// alone: Chinese and Japanese punctuation, which Core Text shapes half as
+// wide alone as between ideographs, kerned Latin pairs, and both scripts
+// side by side.
+var wrapFitTexts = []string{
+	"他也说过，这个城市里有很多米粉店，西边那家最好吃，每天早上都排着长队，大家吃完了才去上班，也有人专门从很远的地方赶过来吃一碗。多米诺骨牌一样，一家接一家地开起来，西门外面的那条街上现在全是卖早点的，吃的东西越来越多，也越来越好。",
+	"“你好，”她说。“今天（星期三）天气不错！我们去公园吧？”——好的、好的；走吧：现在就走……《海上来信》【测试】「引号」",
+	"昨日、東京で新しい店が開きました。「いらっしゃいませ」と店員が言い、客は笑顔で入っていきました。値段は安く、味もいい。",
+	"Welcome back to the show. Today we talk about three things, and AVAWAY To Wa Ye Yo it takes twenty-five minutes; Typography, kerning, and LAVA.",
+	"M4B（含章节）导出的文件 3 个，AI 模型 Qwen3-ASR 识别 25 分钟的音频，速度约 0.2 秒；Kokoro、MOSS 和 SoulX 也可以用。",
+	"    缩进的行，换行以后也缩进：这一行很长，很长，很长，很长，很长，很长，很长，很长，很长，很长，很长，很长，很长。",
+}
+
+// TestWrappedRowsFitTheWrapWidth: every row of a wrapped line, shaped as
+// it paints, fits in the wrap width. Summing the widths of letters shaped
+// alone, rows of Chinese text on macOS came out up to a few letters wider
+// and their last letters were cut at the editor's edge.
+func TestWrappedRowsFitTheWrapWidth(t *testing.T) {
+	for _, family := range []string{"system-ui", "monospace"} {
+		for _, size := range []float32{13, 15, 17} {
+			for _, w := range []int{180, 263, 341, 517, 640, 803, 1000} {
+				st := &State{Buffer: NewBuffer(strings.Join(wrapFitTexts, "\n")), SoftWrap: true,
+					Font: ui.Font{Family: family, Size: size}, LineNumbers: LineNumbersOff}
+				tt := ui.NewTester(func(c *ui.Context) { View(c, st).Fill() }, w, 2000)
+				tt.SetScale(1.25)
+				tt.Frame()
+				v := &st.ed.view
+				if !v.wrap || v.wrapWidth <= 0 {
+					t.Fatalf("%s %gpt at %d: not wrapping", family, size, w)
+				}
+				if edge := st.ed.textX + v.wrapWidth; edge > float32(w)-scrollbarWidth {
+					t.Errorf("%s %gpt at %d: the wrap width ends at %g, under the scroll bar (%d)", family, size, w, edge, w-scrollbarWidth)
+				}
+				rows := 0
+				for n := range wrapFitTexts {
+					l := v.line(n)
+					for _, r := range l.rows {
+						rows++
+						row := l.disp[r.from:r.to]
+						got := text.Shared().Shape(text.Params{Text: row, Style: v.style, NoWrap: true, KeepSpaces: true})
+						// The trailing space of a row hangs, as in any editor.
+						right := r.indent + got.Width - v.widths.width(row[len(strings.TrimRight(row, " ")):])
+						if right > v.wrapWidth+0.01 {
+							t.Errorf("%s %gpt at %d: row %q is %.2f wide, past the wrap width %.0f", family, size, w, row, right, v.wrapWidth)
+						}
+					}
+				}
+				if rows <= len(wrapFitTexts) {
+					t.Errorf("%s %gpt at %d: no line wrapped", family, size, w)
+				}
+			}
+		}
+	}
+}
