diff --git a/ui/editor/wrap_cache_test.go b/ui/editor/wrap_cache_test.go
new file mode 100644
index 0000000..dedd751
--- /dev/null
+++ b/ui/editor/wrap_cache_test.go
@@ -0,0 +1,97 @@
+package editor
+
+import (
+	"slices"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/egoist/mygo/ui"
+)
+
+func wrapCacheView(txt string, width float32) *view {
+	v := &view{}
+	v.setStyle(ui.Font{Family: "system-ui", Size: 15}, 1.6, 2, 4)
+	v.setBuffer(NewBuffer(txt))
+	v.setWrap(true, width)
+	return v
+}
+
+func rowsOf(v *view) [][2]int {
+	var out [][2]int
+	for n := range v.text.LineCount() {
+		for _, r := range v.line(n).rows {
+			out = append(out, [2]int{r.from, r.to})
+		}
+		out = append(out, [2]int{-1, n})
+	}
+	return out
+}
+
+// TestWrapCacheFollowsEdits: the wraps kept by the lines' texts are those
+// a view measuring afresh finds, after an edit and at another width, and
+// an edit leaves what the cache keeps of the lines it did not touch.
+func TestWrapCacheFollowsEdits(t *testing.T) {
+	txt := strings.Repeat(strings.Join(wrapFitTexts, "\n")+"\n", 4)
+	v := wrapCacheView(txt, 341)
+	v.measureWraps(0, time.Hour)
+	if got, want := rowsOf(v), rowsOf(wrapCacheView(txt, 341)); !slices.Equal(got, want) {
+		t.Fatalf("cached rows differ from fresh ones")
+	}
+	first := v.text.Slice(v.text.LineStart(0), v.text.LineEnd(0))
+	at := v.text.LineStart(7) + 6
+	v.buf.Edit(Edit{Start: at, End: at, Text: "加了几个字，"})
+	v.sync(nil)
+	if l := v.wc.lines[first]; l == nil || !l.broken {
+		t.Fatalf("the wraps of line 0, not edited, were forgotten")
+	}
+	v.measureWraps(0, time.Hour)
+	edited := v.buf.String()
+	if got, want := rowsOf(v), rowsOf(wrapCacheView(edited, 341)); !slices.Equal(got, want) {
+		t.Fatalf("rows after an edit differ from fresh ones")
+	}
+	v.setWrap(true, 517)
+	v.measureWraps(0, time.Hour)
+	if got, want := rowsOf(v), rowsOf(wrapCacheView(edited, 517)); !slices.Equal(got, want) {
+		t.Fatalf("rows at another width differ from fresh ones")
+	}
+	for n := range v.text.LineCount() {
+		if got, want := v.heights.wraps.rows(n), len(v.line(n).rows); got != want {
+			t.Fatalf("line %d: measured %d rows, laid out %d", n, got, want)
+		}
+	}
+}
+
+// TestMeasureWrapsKeepsItsBudget: measuring a long text a frame at a
+// time stays near its budget, and measures the lines in view first.
+func TestMeasureWrapsKeepsItsBudget(t *testing.T) {
+	// Lines of other texts: those of one text are shaped once.
+	var b strings.Builder
+	for n := range 1500 {
+		b.WriteString(strconv.Itoa(n) + strings.Repeat(wrapFitTexts[n%3], 3) + "\n")
+	}
+	txt := b.String()
+	v := wrapCacheView(txt, 400)
+	v.shownRows = 20
+	t0 := time.Now()
+	done := v.measureWraps(700, 2*time.Millisecond)
+	took := time.Since(t0)
+	if done {
+		t.Skip("the machine measured 1500 long lines in 2 ms")
+	}
+	if took > 60*time.Millisecond {
+		t.Errorf("a frame's measure took %v with a budget of 2 ms", took)
+	}
+	for n := 700; n < 703; n++ {
+		if v.heights.wraps.extra[n] == wrapUnknown {
+			t.Errorf("line %d in view not measured", n)
+		}
+	}
+	for range 10000 {
+		if v.measureWraps(700, 2*time.Millisecond) {
+			return
+		}
+	}
+	t.Fatal("never measured all")
+}
diff --git a/ui/editor/wrapcache.go b/ui/editor/wrapcache.go
new file mode 100644
index 0000000..c9ea0cc
--- /dev/null
+++ b/ui/editor/wrapcache.go
@@ -0,0 +1,97 @@
+package editor
+
+import (
+	"strings"
+
+	"github.com/egoist/mygo/internal/text"
+)
+
+// wrapCache keeps what soft wraps shaped, so that a line is shaped to wrap
+// once, not at every frame that lays it out again: per displayed line, by
+// its text, the advances its characters take in it (for the style) and
+// where it breaks (for the wrap width too), and the widths of the rows
+// fitRow shaped, by their text. An edit makes new texts, which miss, and
+// leaves those of the lines it did not touch, which hit: typing reshapes
+// the line typed in. Another wrap width keeps the advances and the rows'
+// widths; another style forgets all.
+type wrapCache struct {
+	style text.Style
+	scale float32
+	width float32
+	lines map[string]*wrapLine
+	// rows are the widths of rows shaped, in two generations, as
+	// shapeCache's: cur fills up to wrapRowsMax, then becomes prev.
+	rows, prevRows map[string]float32
+}
+
+// wrapLine is what wrapCache keeps of a displayed line.
+type wrapLine struct {
+	adv    []float32 // lineAdvances
+	breaks []int     // wrapBreaks at wrapCache.width, when measured
+	broken bool      // breaks is measured
+	used   bool      // since the last sweep
+}
+
+// wrapRowsMax bounds a generation of row widths.
+const wrapRowsMax = 8192
+
+// check forgets what does not hold for the style, the wrap width and
+// the scale of the display.
+func (c *wrapCache) check(style text.Style, width, scale float32) {
+	if c.style != style || c.scale != scale || c.lines == nil {
+		*c = wrapCache{style: style, scale: scale, width: width, lines: map[string]*wrapLine{}}
+		return
+	}
+	if c.width != width {
+		c.width = width
+		for _, l := range c.lines {
+			l.breaks, l.broken = nil, false
+		}
+	}
+}
+
+// line returns what is kept of the line s, made empty if nothing.
+func (c *wrapCache) line(s string) *wrapLine {
+	l, ok := c.lines[s]
+	if !ok {
+		// Its own copy: s may share the memory of a larger text.
+		l = &wrapLine{}
+		c.lines[strings.Clone(s)] = l
+	}
+	l.used = true
+	return l
+}
+
+// sweep forgets the lines no layout used since the last sweep once the
+// cache holds many more lines than the text, as after much typing: the
+// texts the lines had before.
+func (c *wrapCache) sweep(lines int) {
+	if len(c.lines) <= 2*lines+256 {
+		return
+	}
+	for s, l := range c.lines {
+		if !l.used {
+			delete(c.lines, s)
+		}
+		l.used = false
+	}
+}
+
+// rowWidth returns the width of row as kept, if it is.
+func (c *wrapCache) rowWidth(row string) (float32, bool) {
+	if w, ok := c.rows[row]; ok {
+		return w, true
+	}
+	if w, ok := c.prevRows[row]; ok {
+		c.setRowWidth(row, w)
+		return w, true
+	}
+	return 0, false
+}
+
+func (c *wrapCache) setRowWidth(row string, w float32) {
+	if c.rows == nil || len(c.rows) >= wrapRowsMax {
+		c.prevRows, c.rows = c.rows, make(map[string]float32, 256)
+	}
+	c.rows[row] = w
+}
