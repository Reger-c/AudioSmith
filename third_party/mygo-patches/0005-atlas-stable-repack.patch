From: AudioSmith
Subject: [PATCH] internal/scene: Repack places rectangles whatever their order

When a glyph atlas fills up, text.System.makeRoom gathers the glyphs and
masks it keeps from its maps and Atlas.Repack places them again, tallest
first. Rectangles of one size kept the order they came in, which is map
order, so the same frame could put a glyph at another place in the atlas
from one run to the next. Glyphs drawn scaled (a zoomed-out canvas) are
sampled at fractional positions, and another place rounds a pixel or two
of them by one level: two renders of the same view differed.

Repack now orders rectangles of one size by their place in the atlas,
which is unique, so where each goes depends on the rectangles alone.
---
diff --git a/internal/scene/atlas.go b/internal/scene/atlas.go
index c6757b8..aac24fb 100644
--- a/internal/scene/atlas.go
+++ b/internal/scene/atlas.go
@@ -181,14 +181,18 @@ func (a *Atlas) Grow() bool {
 
 // Repack frees the atlas and allocates rects, lasting rectangles of it,
 // again, tallest first, moving their pixels along. It returns where each
-// went, or false, changing nothing, when they do not fit.
+// went, or false, changing nothing, when they do not fit. Where each goes
+// does not depend on the order of rects (callers collect them from maps):
+// rectangles of one size keep the order of their places in the atlas.
 func (a *Atlas) Repack(rects []image.Rectangle) ([]image.Point, bool) {
 	order := make([]int, len(rects))
 	for i := range order {
 		order[i] = i
 	}
 	slices.SortFunc(order, func(i, j int) int {
-		return cmp.Or(cmp.Compare(rects[j].Dy(), rects[i].Dy()), cmp.Compare(rects[j].Dx(), rects[i].Dx()))
+		ri, rj := rects[i], rects[j]
+		return cmp.Or(cmp.Compare(rj.Dy(), ri.Dy()), cmp.Compare(rj.Dx(), ri.Dx()),
+			cmp.Compare(ri.Min.Y, rj.Min.Y), cmp.Compare(ri.Min.X, rj.Min.X))
 	})
 	plan := Atlas{W: a.W, H: a.H, top: a.H}
 	pos := make([]image.Point, len(rects))
diff --git a/internal/scene/atlas_test.go b/internal/scene/atlas_test.go
index 993eb79..555205f 100644
--- a/internal/scene/atlas_test.go
+++ b/internal/scene/atlas_test.go
@@ -1,7 +1,10 @@
 package scene
 
 import (
+	"bytes"
 	"image"
+	"math/rand/v2"
+	"slices"
 	"testing"
 )
 
@@ -122,3 +125,46 @@ func TestAtlasRepackAndGrow(t *testing.T) {
 		t.Error("no room after growing")
 	}
 }
+
+// TestAtlasRepackOrder: where Repack puts a rectangle does not depend on
+// the order it is given them in, which comes from maps (the text system's
+// caches): text drawn scaled from the atlas would round otherwise.
+func TestAtlasRepackOrder(t *testing.T) {
+	var place []image.Point
+	for run := range 20 {
+		a := NewAtlas(1, 64, 64)
+		var rects []image.Rectangle
+		for i := range 12 {
+			w, h := 5+i%2, 6+i%3 // many of one size
+			x, y, ok := a.Alloc(w, h)
+			if !ok {
+				t.Fatal("full")
+			}
+			a.Put(x, y, w, h, bytes.Repeat([]byte{byte(i + 1)}, w*h), w)
+			rects = append(rects, image.Rect(x, y, x+w, y+h))
+		}
+		order := rand.New(rand.NewPCG(uint64(run), 1)).Perm(len(rects))
+		shuffled := make([]image.Rectangle, len(rects))
+		for i, j := range order {
+			shuffled[i] = rects[j]
+		}
+		pos, ok := a.Repack(shuffled)
+		if !ok {
+			t.Fatal("Repack: no room")
+		}
+		got := make([]image.Point, len(rects))
+		for i, j := range order {
+			got[j] = pos[i]
+		}
+		if place == nil {
+			place = got
+		} else if !slices.Equal(got, place) {
+			t.Fatalf("run %d: rectangles went to %v, in another order to %v", run, got, place)
+		}
+		for j, p := range got {
+			if v := a.Pix[p.Y*a.W+p.X]; v != byte(j+1) {
+				t.Errorf("run %d: rectangle %d holds %d", run, j, v)
+			}
+		}
+	}
+}
