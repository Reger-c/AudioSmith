From: AudioSmith
Subject: [PATCH] updater: an HTTP client of the app's choosing, and resumed downloads

Update checks and downloads used http.DefaultClient, which reads the proxy
only from environment variables: an app started from the Finder has none,
and Go ignores the macOS system proxy, so behind a proxy (common in China)
checks worked or not by chance and big downloads died part way ("unexpected
EOF"). Updater.SetHTTPClient lets the app give its own client (with its
proxy). A download whose connection drops resumes with a Range request, up
to 4 times, before the update fails. Test: TestDownloadResumesThroughClient.
---
diff --git a/updater.go b/updater.go
index 5d6cea4..71cebfb 100644
--- a/updater.go
+++ b/updater.go
@@ -311,17 +311,33 @@ func applyDelta(ctx context.Context, d update.Delta, pub ed25519.PublicKey, vers
 // download fetches url into the file path and checks its size and
 // signature.
 func download(ctx context.Context, url string, size int64, signature string, pub ed25519.PublicKey, path string, progress func(downloaded, total int64)) error {
-	body, err := httpGet(ctx, url)
-	if err != nil {
-		return err
-	}
-	defer body.Close()
 	f, err := os.Create(path)
 	if err != nil {
 		return err
 	}
 	sum := sha256.New()
-	n, err := io.Copy(io.MultiWriter(f, sum), &progressReader{r: io.LimitReader(body, size+1), total: size, fn: progress})
+	// A connection that drops part way (common through proxies and on
+	// slow networks: "unexpected EOF") resumes where it stopped, a few
+	// times, instead of failing the update.
+	var n int64
+	for try := 0; ; try++ {
+		var body io.ReadCloser
+		body, err = httpGetFrom(ctx, url, n)
+		if err != nil {
+			break
+		}
+		var got int64
+		got, err = io.Copy(io.MultiWriter(f, sum), &progressReader{r: io.LimitReader(body, size+1-n), n: n, total: size, fn: progress})
+		body.Close()
+		n += got
+		if err == nil || ctx.Err() != nil || try >= downloadRetries || n > size {
+			break
+		}
+		select {
+		case <-ctx.Done():
+		case <-time.After(downloadRetryDelay):
+		}
+	}
 	if cerr := f.Close(); err == nil {
 		err = cerr
 	}
@@ -426,9 +442,32 @@ func cleanUpdateLeftovers() {
 	}
 }
 
+// downloadRetries and downloadRetryDelay bound the resumes of a download
+// whose connection dropped.
+var (
+	downloadRetries    = 4
+	downloadRetryDelay = 2 * time.Second
+)
+
+// updateClient is the HTTP client of update checks and downloads (nil:
+// http.DefaultClient). See SetHTTPClient.
+var updateClient atomic.Pointer[http.Client]
+
+// SetHTTPClient makes the updater check and download through c, nil for
+// http.DefaultClient. Apps set it to honour a proxy: http.DefaultClient
+// only reads the proxy environment variables, which apps started from the
+// Finder do not get, and not the macOS system proxy.
+func (u *UpdaterModule) SetHTTPClient(c *http.Client) { updateClient.Store(c) }
+
 // httpGet fetches a URL over HTTPS (or plain HTTP from the loopback
 // interface, for tests).
 func httpGet(ctx context.Context, rawURL string) (io.ReadCloser, error) {
+	return httpGetFrom(ctx, rawURL, 0)
+}
+
+// httpGetFrom is httpGet from byte offset on (a Range request when
+// offset > 0, which must be answered with 206 Partial Content).
+func httpGetFrom(ctx context.Context, rawURL string, offset int64) (io.ReadCloser, error) {
 	u, err := url.Parse(rawURL)
 	if err != nil {
 		return nil, err
@@ -441,11 +480,20 @@ func httpGet(ctx context.Context, rawURL string) (io.ReadCloser, error) {
 		return nil, err
 	}
 	req.Header.Set("User-Agent", "MyGo/"+Version+" "+App.Name()+"/"+App.Version())
-	resp, err := http.DefaultClient.Do(req)
+	want := http.StatusOK
+	if offset > 0 {
+		req.Header.Set("Range", "bytes="+strconv.FormatInt(offset, 10)+"-")
+		want = http.StatusPartialContent
+	}
+	client := updateClient.Load()
+	if client == nil {
+		client = http.DefaultClient
+	}
+	resp, err := client.Do(req)
 	if err != nil {
 		return nil, err
 	}
-	if resp.StatusCode != http.StatusOK {
+	if resp.StatusCode != want {
 		resp.Body.Close()
 		return nil, fmt.Errorf("GET %s: %s", rawURL, resp.Status)
 	}
diff --git a/updater_resume_test.go b/updater_resume_test.go
new file mode 100644
index 0000000..deb7ba2
--- /dev/null
+++ b/updater_resume_test.go
@@ -0,0 +1,81 @@
+package mygo
+
+import (
+	"bytes"
+	"context"
+	"crypto/ed25519"
+	"crypto/sha256"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/egoist/mygo/internal/update"
+)
+
+// A download whose connection drops part way resumes with a Range request,
+// through the client SetHTTPClient gives.
+func TestDownloadResumesThroughClient(t *testing.T) {
+	data := bytes.Repeat([]byte("audiosmith "), 50_000)
+	pub, priv, _ := ed25519.GenerateKey(nil)
+	sum := sha256.Sum256(data)
+	sig := update.Sign(priv, sum[:])
+	var drops, ranges, viaClient atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("X-Test-Client") == "yes" {
+			viaClient.Add(1)
+		}
+		from := 0
+		if rg := r.Header.Get("Range"); rg != "" {
+			ranges.Add(1)
+			from, _ = strconv.Atoi(strings.TrimSuffix(strings.TrimPrefix(rg, "bytes="), "-"))
+			w.Header().Set("Content-Range", "bytes "+strconv.Itoa(from)+"-"+strconv.Itoa(len(data)-1)+"/"+strconv.Itoa(len(data)))
+			w.Header().Set("Content-Length", strconv.Itoa(len(data)-from))
+			w.WriteHeader(http.StatusPartialContent)
+			w.Write(data[from:])
+			return
+		}
+		if drops.Add(1) == 1 { // the first connection dies a third of the way
+			w.Header().Set("Content-Length", strconv.Itoa(len(data)))
+			w.WriteHeader(http.StatusOK)
+			w.Write(data[:len(data)/3])
+			if hj, ok := w.(http.Hijacker); ok {
+				c, _, _ := hj.Hijack()
+				c.Close()
+			}
+			return
+		}
+		w.Write(data)
+	}))
+	defer srv.Close()
+	Updater.SetHTTPClient(&http.Client{Transport: headerTransport{}})
+	defer Updater.SetHTTPClient(nil)
+	defer func(d time.Duration) { downloadRetryDelay = d }(downloadRetryDelay)
+	downloadRetryDelay = time.Millisecond
+	path := filepath.Join(t.TempDir(), "app.tar.gz")
+	var last int64
+	err := download(context.Background(), srv.URL+"/app.tar.gz", int64(len(data)), sig, pub, path, func(d, _ int64) { last = d })
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, _ := os.ReadFile(path)
+	if !bytes.Equal(got, data) || last != int64(len(data)) {
+		t.Fatalf("got %d bytes (progress %d), want %d", len(got), last, len(data))
+	}
+	if ranges.Load() != 1 || viaClient.Load() != 2 {
+		t.Errorf("ranges %d, requests through the client %d", ranges.Load(), viaClient.Load())
+	}
+}
+
+type headerTransport struct{}
+
+func (headerTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	r = r.Clone(r.Context())
+	r.Header.Set("X-Test-Client", "yes")
+	return http.DefaultTransport.RoundTrip(r)
+}
