+// TestWriteDeltasURLPrereleases makes delta updates from the releases and
+// the prereleases served from a URL, whose files are in its beta
+// directory.
+func TestWriteDeltasURLPrereleases(t *testing.T) {
+	pub, priv, _ := ed25519.GenerateKey(nil)
+	t.Setenv("MYGO_UPDATER_PRIVATE_KEY", base64.StdEncoding.EncodeToString(priv))
+	code := make([]byte, 50_000)
+	for i := range code {
+		code[i] = byte(i * i >> 5)
+	}
+	app := func(dir, version string) []string {
+		os.MkdirAll(dir, 0o755)
+		os.WriteFile(filepath.Join(dir, "app"), append(slices.Clone(code), version...), 0o755)
+		return []string{"app"}
+	}
+	serve := t.TempDir()
+	srv := httptest.NewServer(http.FileServer(http.Dir(serve)))
+	defer srv.Close()
+	os.Mkdir(filepath.Join(serve, "beta"), 0o755)
+	archives := map[string]update.Archive{}
+	for v, dir := range map[string]string{"1.0.0": "", "1.1.0": "", "1.2.0-beta.1": "beta/"} {
+		src := filepath.Join(t.TempDir(), v)
+		entries := app(src, v)
+		var archive bytes.Buffer
+		if err := update.WriteArchive(&archive, src, entries); err != nil {
+			t.Fatal(err)
+		}
+		name := dir + "app-" + v + "-linux-amd64.tar.gz"
+		os.WriteFile(filepath.Join(serve, name), archive.Bytes(), 0o644)
+		sum := sha256.Sum256(archive.Bytes())
+		archives[v] = update.Archive{Version: v, URL: srv.URL + "/" + name, Size: int64(archive.Len()), Signature: update.Sign(priv, sum[:])}
+	}
+	manifest := func(path, v string, previous ...string) {
+		a := archives[v]
+		m := update.Manifest{Version: v, URL: a.URL, Size: a.Size, Signature: a.Signature}
+		for _, p := range previous {
+			m.Previous = append(m.Previous, archives[p])
+		}
+		data, _ := json.Marshal(m)
+		os.WriteFile(filepath.Join(serve, path), data, 0o644)
+	}
+	manifest("update-linux-amd64.json", "1.1.0", "1.0.0")
+
+	build := func(version string) (m update.Manifest, deltas []string) {
+		t.Helper()
+		stage := t.TempDir()
+		entries := app(stage, version)
+		c := &Config{root: t.TempDir(), Name: "App", Version: version, Updates: &Updates{PublicKey: base64.StdEncoding.EncodeToString(pub), URL: srv.URL + "/"}}
+		written, err := writeArchive(c, stage, "linux-amd64", entries)
+		if err != nil {
+			t.Fatal(err)
+		}
+		data, _ := os.ReadFile(written[len(written)-1])
+		if err := json.Unmarshal(data, &m); err != nil {
+			t.Fatal(err)
+		}
+		for _, d := range m.Deltas {
+			deltas = append(deltas, d.From)
+		}
+		return m, deltas
+	}
+
+	// Without a beta manifest, from the releases; a prerelease's files are
+	// in the beta directory, and the feed apps read stays the releases'.
+	m, deltas := build("1.2.0-beta.1")
+	if !slices.Equal(deltas, []string{"1.1.0", "1.0.0"}) || m.URL != srv.URL+"/beta/app-1.2.0-beta.1-linux-amd64.tar.gz" || m.Deltas[0].URL != srv.URL+"/beta/app-1.1.0-to-1.2.0-beta.1-linux-amd64.delta" {
+		t.Errorf("first prerelease: deltas from %v, %+v", deltas, m)
+	}
+	c := &Config{Version: "1.2.0-beta.1", Updates: &Updates{URL: "https://dl.example.com/app"}}
+	if got := c.updateFeed("darwin-arm64"); got != "https://dl.example.com/app/update-darwin-arm64.json" {
+		t.Errorf("the feed of a prerelease: %s", got)
+	}
+	// With one, from both: the next prerelease, and the release.
+	manifest("beta/update-linux-amd64.json", "1.2.0-beta.1", "1.1.0", "1.0.0")
+	if _, deltas := build("1.2.0-beta.2"); !slices.Equal(deltas, []string{"1.2.0-beta.1", "1.1.0", "1.0.0"}) {
+		t.Errorf("next prerelease: deltas from %v", deltas)
+	}
+	if m, deltas := build("1.2.0"); !slices.Equal(deltas, []string{"1.2.0-beta.1", "1.1.0", "1.0.0"}) || m.URL != srv.URL+"/app-1.2.0-linux-amd64.tar.gz" {
+		t.Errorf("release: deltas from %v, %s", deltas, m.URL)
+	}
+}
