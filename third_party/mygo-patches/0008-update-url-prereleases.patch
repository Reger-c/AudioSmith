+		if !isNotFound(perr) {
+			log.Printf("mygo: checked the releases for updates, as the prereleases' manifest could not be read: %v", perr)
+		}
+		return m, nil
+	case isNotFound(err) && !isNotFound(perr):
+		return update.Manifest{}, perr
+	}
