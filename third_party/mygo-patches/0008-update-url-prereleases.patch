+func TestUpdaterURLPrereleases(t *testing.T) {
+	ctx := context.Background()
+	_, key, beta, requests := updateServer(t, "1.3.0-beta.1", "v2, a bigger version", "")
+	stable := beta
+	stable.Version = "1.2.0"
+	var mu sync.Mutex
+	status := map[string]int{"/app/update.json": http.StatusOK, "/app/beta/update.json": http.StatusOK}
+	served := map[string]*update.Manifest{"/app/update.json": &stable, "/app/beta/update.json": &beta}
+	feeds := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		defer mu.Unlock()
+		m, ok := served[r.URL.Path]
+		switch {
+		case !ok || status[r.URL.Path] == http.StatusNotFound:
+			http.NotFound(w, r)
+		case status[r.URL.Path] != http.StatusOK:
+			http.Error(w, "unavailable", status[r.URL.Path])
+		default:
+			json.NewEncoder(w).Encode(m)
+		}
+	}))
+	defer feeds.Close()
+	feed := feeds.URL + "/app/update.json"
+	set := func(releases, prereleases int, stableVersion string) {
+		mu.Lock()
+		status["/app/update.json"], status["/app/beta/update.json"] = releases, prereleases
+		stable.Version = stableVersion
+		mu.Unlock()
+	}
+
+	for _, c := range []struct {
+		releases, prereleases int
+		stable                string
+		current               string
+		on                    bool
+		want                  string // "" for up to date, "error" for an error
+	}{
+		// The newer of the two manifests, with prereleases.
+		{200, 200, "1.2.0", "1.1.0", true, "1.3.0-beta.1"},
+		{200, 200, "1.2.0", "1.1.0", false, "1.2.0"},
+		{200, 200, "1.3.0", "1.3.0-beta.1", true, "1.3.0"},
+		{200, 200, "1.2.0", "1.3.0-beta.1", true, ""},
+		// Leaving the prereleases never goes back to the release before.
+		{200, 200, "1.2.0", "1.3.0-beta.1", false, ""},
+		// No beta manifest: the releases', as before.
+		{404, 404, "1.2.0", "1.1.0", true, "error"},
+		{200, 404, "1.2.0", "1.1.0", true, "1.2.0"},
+		{200, 503, "1.2.0", "1.1.0", true, "1.2.0"},
+		// Only prereleases published.
+		{404, 200, "1.2.0", "1.1.0", true, "1.3.0-beta.1"},
+		{404, 200, "1.2.0", "1.1.0", false, "error"},
+	} {
+		set(c.releases, c.prereleases, c.stable)
+		up, err := checkUpdate(ctx, feed, key, c.current, c.on)
+		name := fmt.Sprintf("releases %d, prereleases %d, %s, from %s, prereleases %t", c.releases, c.prereleases, c.stable, c.current, c.on)
+		switch {
+		case c.want == "error":
+			if err == nil {
+				t.Errorf("%s: no error, %+v", name, up)
+			}
+		case err != nil:
+			t.Errorf("%s: %v", name, err)
+		case c.want == "" && up != nil:
+			t.Errorf("%s: offered %s", name, up.Version)
+		case c.want != "" && (up == nil || up.Version != c.want):
+			t.Errorf("%s: offered %+v, want %s", name, up, c.want)
+		}
+	}
+	// Both missing: the error names the releases' manifest; a broken beta
+	// directory beside no release names the beta one.
+	set(404, 404, "1.2.0")
+	if _, err := checkUpdate(ctx, feed, key, "1.1.0", true); err == nil || !strings.Contains(err.Error(), "/app/update.json: 404") {
+		t.Errorf("nothing published: %v", err)
+	}
+	set(404, 503, "1.2.0")
+	if _, err := checkUpdate(ctx, feed, key, "1.1.0", true); err == nil || !strings.Contains(err.Error(), "/app/beta/update.json: 503") {
+		t.Errorf("no release, a broken beta directory: %v", err)
+	}
+	// Without prereleases the beta manifest is never asked for.
+	set(200, 200, "1.2.0")
+	var asked int
+	feeds.Config.Handler = func(h http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if strings.Contains(r.URL.Path, "/beta/") {
+				asked++
+			}
+			h.ServeHTTP(w, r)
+		})
+	}(feeds.Config.Handler)
+	if _, err := checkUpdate(ctx, feed, key, "1.1.0", false); err != nil || asked != 0 {
+		t.Errorf("releases only: %v, asked the beta manifest %d times", err, asked)
+	}
+
+	// The prerelease installs, signed with the app's key.
+	up, err := checkUpdate(ctx, feed, key, "1.2.0", true)
+	if err != nil || up == nil {
+		t.Fatalf("checkUpdate = %+v, %v", up, err)
+	}
+	target, main := installedApp(t)
+	if err := installUpdate(ctx, up.manifest, key, up.current, target, nil); err != nil {
+		t.Fatal(err)
+	}
+	if b, _ := os.ReadFile(main); string(b) != "v2, a bigger version" || requests("/app.tar.gz") != 1 {
+		t.Errorf("after the update main = %q, %d downloads", b, requests("/app.tar.gz"))
+	}
+}
