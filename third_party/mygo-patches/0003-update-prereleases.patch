+// TestWriteDeltasPrereleases makes delta updates on GitHub from the
+// published releases and prereleases.
+func TestWriteDeltasPrereleases(t *testing.T) {
+	pub, priv, _ := ed25519.GenerateKey(nil)
+	t.Setenv("MYGO_UPDATER_PRIVATE_KEY", base64.StdEncoding.EncodeToString(priv))
+	t.Setenv("GH_TOKEN", "")
+	t.Setenv("GITHUB_TOKEN", "")
+	code := make([]byte, 50_000)
+	for i := range code {
+		code[i] = byte(i * i >> 3)
+	}
+	app := func(dir, version string) []string {
+		os.MkdirAll(dir, 0o755)
+		os.WriteFile(filepath.Join(dir, "app"), append(slices.Clone(code), version...), 0o755)
+		return []string{"app"}
+	}
+	// The release files, by path, and how the API and the latest release
+	// answer.
+	files := map[string][]byte{}
+	var mu sync.Mutex
+	apiStatus, latest := http.StatusOK, true
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		defer mu.Unlock()
+		path := r.URL.Path
+		switch {
+		case path == "/api/repos/me/app/releases":
+			if apiStatus != http.StatusOK {
+				http.Error(w, "API rate limit exceeded", apiStatus)
+				return
+			}
+			if r.URL.Query().Get("page") != "1" {
+				w.Write([]byte("[]"))
+				return
+			}
+			// Newest first: a draft of the version being built, the
+			// prerelease, then the releases.
+			w.Write([]byte(`[{"tag_name": "v1.2.0-beta.2", "draft": true, "prerelease": true},
+				{"tag_name": "v1.2.0-beta.1", "draft": false, "prerelease": true},
+				{"tag_name": "v1.1.0", "draft": false, "prerelease": false},
+				{"tag_name": "v1.0.0", "draft": false, "prerelease": false}]`))
+			return
+		case strings.HasPrefix(path, "/me/app/releases/latest/download/"):
+			if !latest {
+				http.NotFound(w, r)
+				return
+			}
+			path = "/me/app/releases/download/v1.1.0/" + strings.TrimPrefix(path, "/me/app/releases/latest/download/")
+		}
+		if b, ok := files[path]; ok {
+			w.Write(b)
+			return
+		}
+		http.NotFound(w, r)
+	}))
+	defer srv.Close()
+	api, site := update.GitHubAPI, update.GitHub
+	update.GitHubAPI, update.GitHub = srv.URL+"/api", srv.URL
+	t.Cleanup(func() { update.GitHubAPI, update.GitHub = api, site })
+
+	archives := map[string]update.Archive{}
+	for _, v := range []string{"1.0.0", "1.1.0", "1.2.0-beta.1"} {
+		dir := filepath.Join(t.TempDir(), v)
+		entries := app(dir, v)
+		var archive bytes.Buffer
+		if err := update.WriteArchive(&archive, dir, entries); err != nil {
+			t.Fatal(err)
+		}
+		path := "/me/app/releases/download/v" + v + "/app-" + v + "-linux-amd64.tar.gz"
+		files[path] = archive.Bytes()
+		sum := sha256.Sum256(archive.Bytes())
+		archives[v] = update.Archive{Version: v, URL: srv.URL + path, Size: int64(archive.Len()), Signature: update.Sign(priv, sum[:])}
+	}
+	manifest := func(v string, previous ...string) {
+		a := archives[v]
+		m := update.Manifest{Version: v, URL: a.URL, Size: a.Size, Signature: a.Signature}
+		for _, p := range previous {
+			m.Previous = append(m.Previous, archives[p])
+		}
+		files["/me/app/releases/download/v"+v+"/update-linux-amd64.json"], _ = json.Marshal(m)
+	}
+	manifest("1.0.0")
+	manifest("1.1.0", "1.0.0")
+	manifest("1.2.0-beta.1", "1.1.0", "1.0.0")
+
+	build := func(version string) (deltas, previous []string) {
+		t.Helper()
+		stage := t.TempDir()
+		entries := app(stage, version)
+		c := &Config{root: t.TempDir(), Name: "App", Version: version, Updates: &Updates{PublicKey: base64.StdEncoding.EncodeToString(pub), GitHub: "me/app"}}
+		if err := c.Updates.validate(); err != nil {
+			t.Fatal(err)
+		}
+		written, err := writeArchive(c, stage, "linux-amd64", entries)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var m update.Manifest
+		data, _ := os.ReadFile(written[len(written)-1])
+		if err := json.Unmarshal(data, &m); err != nil {
+			t.Fatal(err)
+		}
+		for _, d := range m.Deltas {
+			if want := srv.URL + "/me/app/releases/download/v" + version + "/app-" + d.From + "-to-" + version + "-linux-amd64.delta"; d.URL != want {
+				t.Errorf("delta URL %s, want %s", d.URL, want)
+			}
+			old := filepath.Join(t.TempDir(), "old")
+			app(old, d.From)
+			f, err := os.Open(filepath.Join(stage, filepath.Base(d.URL)))
+			if err != nil {
+				t.Fatal(err)
+			}
+			out := filepath.Join(t.TempDir(), "new")
+			err = update.ApplyDelta(f, d.Size, d.From, version, old, out)
+			f.Close()
+			if err != nil {
+				t.Fatalf("the delta from %s: %v", d.From, err)
+			}
+		}
+		for _, d := range m.Deltas {
+			deltas = append(deltas, d.From)
+		}
+		for _, a := range m.Previous {
+			previous = append(previous, a.Version)
+		}
+		return deltas, previous
+	}
+
+	// The next prerelease, and the release, update both the prerelease
+	// and the releases before it.
+	for _, version := range []string{"1.2.0-beta.2", "1.2.0"} {
+		if deltas, previous := build(version); !slices.Equal(deltas, []string{"1.2.0-beta.1", "1.1.0", "1.0.0"}) || !slices.Equal(previous, []string{"1.2.0-beta.1", "1.1.0"}) {
+			t.Errorf("%s: deltas from %v, previous %v", version, deltas, previous)
+		}
+	}
+	// With only prereleases published.
+	mu.Lock()
+	latest = false
+	mu.Unlock()
+	if deltas, _ := build("1.2.0-beta.2"); !slices.Equal(deltas, []string{"1.2.0-beta.1", "1.1.0", "1.0.0"}) {
+		t.Errorf("only prereleases: deltas from %v", deltas)
+	}
+	// When the API fails, from the latest release.
+	mu.Lock()
+	latest, apiStatus = true, http.StatusForbidden
+	mu.Unlock()
+	if deltas, _ := build("1.2.0-beta.2"); !slices.Equal(deltas, []string{"1.1.0", "1.0.0"}) {
+		t.Errorf("without the API: deltas from %v", deltas)
+	}
+}
