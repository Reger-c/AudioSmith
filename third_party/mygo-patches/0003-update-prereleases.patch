+			t.Errorf("from %s, prereleases %t: %v", c.current, c.prereleases, err)
+		case c.want == "" && up != nil:
+			t.Errorf("from %s, prereleases %t: offered %s", c.current, c.prereleases, up.Version)
+		case c.want != "" && (up == nil || up.Version != c.want):
+			t.Errorf("from %s, prereleases %t: offered %+v, want %s", c.current, c.prereleases, up, c.want)
+		}
+	}
+
+	// The prerelease installs from its delta, signed with the app's key.
+	up, err := checkUpdate(ctx, feed, key, "1.2.0", true)
+	if err != nil || up == nil {
+		t.Fatalf("checkUpdate = %+v, %v", up, err)
+	}
+	target, main := installedApp(t)
+	if err := installUpdate(ctx, up.manifest, key, up.current, target, nil); err != nil {
+		t.Fatal(err)
+	}
+	if b, _ := os.ReadFile(main); string(b) != "v2, a bigger version" {
+		t.Errorf("after the update main = %q", b)
+	}
+	if requests("/app.delta") != 1 || requests("/app.tar.gz") != 0 {
+		t.Errorf("downloaded the delta %d times and the archive %d", requests("/app.delta"), requests("/app.tar.gz"))
+	}
+
+	// Past the API's limit, the latest release is checked instead; with
+	// none, the check fails with the API's error.
+	set(http.StatusForbidden, http.StatusOK)
+	if up, err := checkUpdate(ctx, feed, key, "1.1.0", true); err != nil || up == nil || up.Version != "1.2.0" {
+		t.Errorf("without the API: %+v, %v", up, err)
+	}
+	set(http.StatusForbidden, http.StatusNotFound)
+	if _, err := checkUpdate(ctx, feed, key, "1.1.0", true); err == nil || !strings.Contains(err.Error(), "403") {
+		t.Errorf("without the API and a release: %v", err)
+	}
+	// A beta-only repository: no latest release, the prerelease is found.
+	set(http.StatusOK, http.StatusNotFound)
+	if up, err := checkUpdate(ctx, feed, key, "1.0.0", true); err != nil || up == nil || up.Version != "1.3.0-beta.1" {
+		t.Errorf("only prereleases: %+v, %v", up, err)
+	}
+	if _, err := checkUpdate(ctx, feed, key, "1.0.0", false); err == nil {
+		t.Error("found a release where only prereleases are published")
+	}
+
+	if Updater.Prereleases() {
+		t.Error("prereleases are on by default")
+	}
+	Updater.SetPrereleases(true)
+	if !Updater.Prereleases() {
+		t.Error("SetPrereleases(true) did not turn them on")
+	}
+	Updater.SetPrereleases(false)
+}
