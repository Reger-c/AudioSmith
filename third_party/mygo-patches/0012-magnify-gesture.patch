 	rt.chain = chain[:0]
diff --git a/ui/magnify_test.go b/ui/magnify_test.go
new file mode 100644
index 0000000..47de78b
--- /dev/null
+++ b/ui/magnify_test.go
@@ -0,0 +1,34 @@
+package ui
+
+import "testing"
+
+// TestMagnify: a pinch goes to the element under the pointer that handles
+// its input, at the pointer, with the change of scale; ScrollWith brings
+// the modifiers held.
+func TestMagnify(t *testing.T) {
+	var got []InputEvent
+	tt := coreNewTester(func(c *context) {
+		coreRow(c).Children(func() {
+			coreBox(c).Size(100, 100)
+			coreBox(c).Size(100, 100).HandleInput(func(ev InputEvent) bool {
+				if ev.Kind == InputMagnify || ev.Kind == InputScroll {
+					got = append(got, ev)
+					return true
+				}
+				return false
+			})
+		})
+	}, 200, 100)
+	tt.Magnify(50, 50, 0.5) // over the box that takes nothing
+	tt.Magnify(150, 40, 0.25)
+	tt.ScrollWith(Super, 120, 10, 0, -8)
+	if len(got) != 2 {
+		t.Fatalf("events %+v", got)
+	}
+	if e := got[0]; e.Kind != InputMagnify || e.Magnify != 0.25 || e.X != 50 || e.Y != 40 {
+		t.Errorf("magnify %+v", e)
+	}
+	if e := got[1]; e.Kind != InputScroll || e.Mods != Super || e.DY != -8 || e.X != 20 {
+		t.Errorf("scroll %+v", e)
+	}
+}
