+    /// Cangjie codes of Chinese characters (Cangjie5_TC.json beside the
+    /// weights), as [cj_x]…[cj_.] tokens, numbered among the characters
+    /// sharing a code like Resemble's ChineseCangjieConverter. AudioSmith patch.
+    private var cangjieTable: (word2cj: [String: String], cj2word: [String: [String]])?
+
+    private func cangjie(_ text: String) -> String {
+        if cangjieTable == nil {
+            var word2cj: [String: String] = [:]
+            var cj2word: [String: [String]] = [:]
+            if let dir = modelDir,
+               let data = try? Data(contentsOf: dir.appendingPathComponent("Cangjie5_TC.json")),
+               let entries = try? JSONSerialization.jsonObject(with: data) as? [String] {
+                for entry in entries {
+                    let parts = entry.split(separator: "\t", omittingEmptySubsequences: false)
+                    guard parts.count >= 2 else { continue }
+                    let word = String(parts[0]), code = String(parts[1])
+                    word2cj[word] = code
+                    cj2word[code, default: []].append(word)
+                }
+            }
+            cangjieTable = (word2cj, cj2word)
+        }
+        guard let table = cangjieTable, !table.word2cj.isEmpty else { return text }
+        var out = ""
+        for ch in text {
+            let glyph = String(ch)
+            guard ch.unicodeScalars.first?.properties.generalCategory == .otherLetter, let code = table.word2cj[glyph] else {
+                out.append(ch)
+                continue
+            }
+            let i = table.cj2word[code]?.firstIndex(of: glyph) ?? 0
+            for c in code + (i > 0 ? String(i) : "") { out += "[cj_\(c)]" }
+            out += "[cj_.]"
+        }
+        return out
+    }
